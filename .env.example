# Exposed host ports (defaults shown)
FRONTEND_PORT=5174
BACKEND_PORT=8001
DB_PORT=5434

# PostgreSQL
POSTGRES_DB=llm_benchmark
POSTGRES_USER=benchmarker
POSTGRES_PASSWORD=benchmarker_secret

# Security & optional initial seed user
JWT_SECRET_KEY=calibrai-dev-jwt-secret-change-in-production
DEFAULT_ADMIN_USER=
DEFAULT_ADMIN_PASSWORD=

# LLM Providers (optional; can also be configured in the UI)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
